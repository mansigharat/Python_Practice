# without type hints
def add(a, b):
    return a + b

# with type hints
def add(a: int, b: int) -> int:
    return a + b

def info(name: str, age: int) -> str:
    return f"My name is {name} and my age is {age}"
print(info("Alias",23))

def sub(a: int, b: int) -> int:
    return a - b
print(sub(40,21))

def mul(x: int, y: int) -> int:
    return x*y
print(mul(12,5))


def add_return(a, b):
    return a + b

def add_print(a, b):
    print(a + b)

# return version
result = add_return(2, 3)  # result = 5, you can use it
print(result * 2)          # 10, because you stored it

# print version
result = add_print(2, 3)   # prints 5 but result = None
print(result * 2)          # crashes, None * 2 is invalid
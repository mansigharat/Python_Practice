from abc import ABC, abstractmethod

class BaseAgent(ABC):
    def __init__(self, name, model):
        self.name = name
        self.__model = model       # encapsulation

    def get_model(self):
        return self.__model

    @abstractmethod
    def run(self):                 # abstract, every agent must implement
        pass

    @staticmethod
    def is_valid_input(text):      # utility, no agent data needed
        return len(text) > 0

    @classmethod
    def from_config(cls, config):  # create agent from config file
        return cls(config["name"], config["model"])


class ResearchAgent(BaseAgent):    # inheritance
    def run(self):                 # polymorphism
        print(f"{self.name} is searching the web")


class WriterAgent(BaseAgent):      # inheritance
    def run(self):                 # polymorphism
        print(f"{self.name} is writing content")


agents = [ResearchAgent("R1", "gpt-4"), WriterAgent("W1", "claude-3")]

for agent in agents:               # polymorphism in action
    agent.run()